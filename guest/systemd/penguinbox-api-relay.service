[Unit]
Description=PenguinBox API relay for the sandbox container
After=network-online.target penguinboxd.service
Wants=penguinboxd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/penguinbox-api-relay
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
