#!/bin/sh
# Relay the sandbox container's forwarded port to the loopback-only API.
# passt forwards container port 1338 to the guest address. Only the passt
# gateway may connect; payload containers reach the same address over the
# Podman bridge and are rejected by the source range.
set -eu

port=1338
address=$(ip -4 route get 1.1.1.1 |
    awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }')
gateway=$(ip -4 route show default |
    awk '{ for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }')
if [ -z "$address" ] || [ -z "$gateway" ]; then
    echo "penguinbox-api-relay: no IPv4 address or default gateway" >&2
    exit 1
fi

exec socat \
    "TCP4-LISTEN:${port},bind=${address},fork,reuseaddr,range=${gateway}/32" \
    "TCP4:127.0.0.1:${port}"
